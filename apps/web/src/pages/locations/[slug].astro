---
import Layout from "../../layouts/Layout.astro";
import LocationDetail from "@/components/location/location-detail.astro";
import LocationNotFound from "@/components/location/location-not-found.astro";
import { buildLocationPageLayoutMeta } from "@/lib/location-page-seo";
import { getSanityLocationRecordBySlug } from "@/lib/sanity-location-repository";
import { getSiteOrigin } from "@/lib/site-url";
import {
  getSelectedPhotoCollectionTitle,
  isSelectedPhotoCollectionValue,
} from "@/lib/selected-photo-collections";

const { slug } = Astro.params;
let location: Awaited<ReturnType<typeof getSanityLocationRecordBySlug>>;

try {
  location = slug ? await getSanityLocationRecordBySlug(slug) : undefined;
} catch (error) {
  console.error("[locations/[slug]] Sanity fetch failed:", error);
  Astro.response.status = 503;
  location = undefined;
}

if (!location && Astro.response.status !== 503) {
  Astro.response.status = 404;
}

const collectionParam = Astro.url.searchParams.get("collection");
const activeCollection =
  collectionParam != null && isSelectedPhotoCollectionValue(collectionParam)
    ? collectionParam
    : undefined;
const collectionTitle = activeCollection
  ? getSelectedPhotoCollectionTitle(activeCollection)
  : undefined;
const displayPhotos =
  location && activeCollection
    ? location.photos.filter(
        (photo) => photo.selectedCollection === activeCollection,
      )
    : location?.photos;

const highlightPhotoParam = Astro.url.searchParams.get("photo");
const initialPhotoId =
  displayPhotos != null &&
  highlightPhotoParam != null &&
  displayPhotos.some((photo) => photo.id === highlightPhotoParam)
    ? highlightPhotoParam
    : undefined;

const isUnavailable = Astro.response.status === 503;

const siteOrigin = getSiteOrigin();
const { pageTitle, pageDescription, previewSrc, previewAlt, jsonLd } =
  buildLocationPageLayoutMeta(location, siteOrigin, {
    collectionTitle,
    displayPhotos,
  });
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={previewSrc}
  imageAlt={previewAlt}
  jsonLd={jsonLd ? [jsonLd] : undefined}
  robots={location ? undefined : "noindex, nofollow"}
>
  <main
    id="main-content"
    class="container mx-auto max-w-7xl space-y-6 px-4 py-6"
  >
    {location && displayPhotos ? (
      <LocationDetail
        location={{ ...location, photos: displayPhotos }}
        highlightPhotoId={initialPhotoId}
      />
    ) : isUnavailable ? (
      <section class="space-y-4">
        <h1 class="text-2xl font-bold">Temporarily unavailable</h1>
        <p class="text-sm text-on-surface-variant">
          Location data could not be loaded. Please try again shortly.
        </p>
      </section>
    ) : (
      <LocationNotFound />
    )}
  </main>
</Layout>
