---
import Layout from '../../layouts/Layout.astro'
import BackToMapLink from '@/components/location/back-to-map-link.astro'
import { LocationPhotoGalleryLauncherIsland } from '@/components/location/location-photo-gallery-launcher-island'
import { fetchThemePhotos } from '@/lib/sanity-location-repository'
import {
	SELECTED_PHOTO_COLLECTIONS,
	getSelectedPhotoCollectionTitle,
	isSelectedPhotoCollectionValue,
} from '@/lib/selected-photo-collections'

export function getStaticPaths() {
	return SELECTED_PHOTO_COLLECTIONS.map(({ value }) => ({
		params: { collection: value },
	}))
}

const { collection } = Astro.params
const isValidCollection =
	collection != null && isSelectedPhotoCollectionValue(collection)

if (!isValidCollection) {
	Astro.response.status = 404
}

const themeTitle = isValidCollection
	? getSelectedPhotoCollectionTitle(collection)
	: undefined
const photos = isValidCollection ? await fetchThemePhotos(collection) : []
const highlightPhotoId = Astro.url.searchParams.get('photo')

const pageTitle = themeTitle
	? `${themeTitle} — Tredyffrin Aerial Photos`
	: 'Theme not found — Tredyffrin Aerial Photos'
const pageDescription = themeTitle
	? `Aerial photographs in the ${themeTitle} collection across the archive.`
	: 'This theme is not listed in the Tredyffrin aerial photograph archive.'
const previewPhoto = photos[0]
---

<Layout
	title={pageTitle}
	description={pageDescription}
	image={previewPhoto?.src}
	imageAlt={previewPhoto?.alt}
	robots={isValidCollection ? undefined : 'noindex, nofollow'}
>
	<main
		id="main-content"
		class="relative mx-auto max-w-7xl px-6 py-6 md:px-10"
	>
		{isValidCollection ? (
			<section class="flex flex-col gap-8 md:gap-10">
				<BackToMapLink />

				<div class="md:max-w-md">
					<h1 class="font-display text-3xl font-light tracking-[-0.01em] md:text-[2.5rem]">
						{themeTitle}
					</h1>
				</div>

				{photos.length > 0 ? (
					<section>
						<h2 class="text-lg font-bold mb-8">
							Photos ({photos.length})
						</h2>
						<LocationPhotoGalleryLauncherIsland
							client:load
							photos={photos}
							initialPhotoId={highlightPhotoId}
						/>
					</section>
				) : (
					<section class="rounded-lg border bg-card p-6 text-sm text-muted-foreground">
						No photographs are tagged for this theme yet.
					</section>
				)}
			</section>
		) : (
			<section class="space-y-4">
				<BackToMapLink />
				<h1 class="text-2xl font-bold">Theme not found</h1>
				<p class="text-sm text-on-surface-variant">
					This theme is not listed in the archive.
				</p>
			</section>
		)}
	</main>
</Layout>
