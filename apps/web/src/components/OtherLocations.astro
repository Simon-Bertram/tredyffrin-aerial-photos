---
import type { OtherLocationPlaceLink } from "@/lib/sanity-location-repository";

interface Props {
  places: OtherLocationPlaceLink[];
}

const { places } = Astro.props;
---

{
  places.length > 0 && (
    <section
      id="other-locations"
      class="relative mx-auto max-w-7xl px-6 pb-24 md:px-10 md:pb-32"
    >
      <div class="flex flex-col gap-8 md:gap-10">
        <div class="md:max-w-md">
          <h2 class="mt-3 font-display text-3xl font-light tracking-[-0.01em] md:text-[2.5rem]">
            Other <span class="italic">locations.</span>
          </h2>
          <p class="mt-4 max-w-xs text-sm leading-relaxed text-on-surface-variant">
            Here are some other locations that you may be interested in.
          </p>
        </div>
        <ul class="columns-1 gap-2 sm:columns-2 lg:columns-3">
          {places.map((place) => (
            <li class="break-inside-avoid">
              <a
                href={place.href}
                class="text-foreground underline-offset-4 hover:text-primary hover:underline"
              >
                {place.name} ({place.photoCount})
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
