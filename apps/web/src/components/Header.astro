---
import GalleryPicker from "./GalleryPicker.astro";
import { buildGalleryNavGroups } from "@/lib/sanity-location-repository";
import { getHeaderSanityData } from "@/lib/header-sanity-data";

const links = [{ to: "/about", label: "About" }];
const rawPath = Astro.url.pathname;
const pathname =
  rawPath.length > 1 && rawPath.endsWith("/") ? rawPath.slice(0, -1) : rawPath;

const { navItems, themeCounts, tredyffrinEasttownTitle } =
  await getHeaderSanityData(Astro.locals);
const groups = buildGalleryNavGroups(navItems, themeCounts, {
  tredyffrinEasttownLabel: tredyffrinEasttownTitle,
});
---

<header class="relative bg-secondary-wash">
  <div
    class="mx-auto flex max-w-7xl flex-col items-start gap-5 px-6 pt-8 pb-6 md:flex-row md:items-baseline md:justify-between md:gap-6 md:px-10 md:pt-10"
  >
    <a
      href="/"
      class="group flex items-baseline gap-3"
      aria-current={pathname === "/" ? "page" : undefined}
    >
      <span
        class="font-display text-xl font-light tracking-[-0.01em] md:text-[1.65rem]"
      >
        Tredyffrin Easttown<span
          class="text-on-surface-variant italic font-normal group-hover:text-primary transition-colors"
          >&thinsp;&middot;&thinsp;Aerial Archive</span
        >
      </span>
    </a>

    <nav
      aria-label="Primary"
      class="flex w-full flex-col items-stretch gap-3 tracking-wide md:w-auto md:flex-row md:flex-wrap md:items-baseline md:justify-end md:gap-6"
    >
      <GalleryPicker groups={groups} currentPath={pathname} />
      {
        links.map((link) => (
          <a
            href={link.to}
            class="inline-flex min-h-11 items-center px-3 text-sm text-on-surface-variant transition-colors hover:text-primary md:min-h-0 md:px-0 md:text-base"
            aria-current={pathname === link.to ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
  <!-- Tonal seam instead of a divider line. -->
  <div
    class="mx-auto h-px max-w-7xl bg-[linear-gradient(to_right,transparent,color-mix(in_srgb,var(--outline-variant)_58%,transparent),transparent)]"
  >
  </div>
</header>
