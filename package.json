{
  "name": "tredyffrin-aerial-photos",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@cloudflare/workers-types": "^4.20251213.0",
      "alchemy": "^0.93.9"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo -F web dev",
    "dev:infra": "turbo -F @tredyffrin-aerial-photos/infra dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:unit": "vitest run",
    "test:web": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install --with-deps chromium",
    "dev:web": "turbo -F web dev",
    "predeploy:assert-bun": "$HOME/.bun/bin/bun run ./packages/infra/scripts/assert-bun-version.ts",
    "predeploy:prerender-check": "PATH=\"$HOME/.bun/bin:$PATH\" bun run predeploy:assert-bun && PATH=\"$HOME/.bun/bin:$PATH\" bun run ./packages/infra/scripts/prerender-safety-check.ts",
    "deploy": "PATH=\"$HOME/.bun/bin:$PATH\" bun run predeploy:assert-bun && PATH=\"$HOME/.bun/bin:$PATH\" turbo -F @tredyffrin-aerial-photos/infra deploy",
    "deploy:safe": "PATH=\"$HOME/.bun/bin:$PATH\" bun run predeploy:prerender-check && PATH=\"$HOME/.bun/bin:$PATH\" bun run deploy",
    "deploy:preflight": "turbo -F @tredyffrin-aerial-photos/infra preflight:cloudflare",
    "destroy": "turbo -F @tredyffrin-aerial-photos/infra destroy"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@tredyffrin-aerial-photos/env": "workspace:*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tredyffrin-aerial-photos/config": "workspace:*",
    "@types/node": "^25.9.1",
    "jsdom": "^29.1.1",
    "@playwright/test": "^1.56.1",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "bun@1.3.12"
}
