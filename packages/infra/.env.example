# Loaded by alchemy.run.ts after ../../apps/web/.env. Values here override the
# web app .env for deploy/preflight (PUBLIC_SERVER_URL, ALCHEMY_STAGE, Cloudflare).
#
# Alchemy deployment stage (scopes state under .alchemy/{stage}/). Without this,
# Alchemy defaults to your OS username (e.g. "si"). Use "production" for live.
ALCHEMY_STAGE=production

# Set PUBLIC_SERVER_URL to the canonical HTTPS URL of the deployed site before
# deploy (no trailing slash). This value is passed to the Worker as a binding
# and must match what users see in the browser.
PUBLIC_SERVER_URL=https://example.com

# Cloudflare (Alchemy / Wrangler). Use a valid Account API Token; a bad token
# override: true so values here win over apps/web/.env and a stale
# CLOUDFLARE_API_TOKEN in your shell. To use OAuth instead, omit this variable
# shell. To use OAuth instead, omit this variable and run `wrangler login`.
# Token needs Cache Purge permission for post-deploy edge cache purge.
# CLOUDFLARE_API_TOKEN=
#
# Optional zone ID for post-deploy cache purge. When omitted, the purge script
# resolves the zone from PUBLIC_SERVER_URL (custom domains only).
# CLOUDFLARE_ZONE_ID=
#
# Set to 0 to skip post-deploy Cloudflare cache purge.
# CLOUDFLARE_PURGE_CACHE=1
